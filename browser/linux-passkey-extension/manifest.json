{
  "manifest_version": 3,
  "name": "linux-passkey",
  "version": "0.3.0",
  "description": "Use linux-passkey (TPM / Secure Enclave) as this computer's built-in passkey authenticator, instead of a virtual USB security key.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "scripts": [
      "service-worker.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "linux-passkey@koxu1996",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "suggest.html",
        "suggest.js",
        "suggest.css"
      ],
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ]
    }
  ]
}
